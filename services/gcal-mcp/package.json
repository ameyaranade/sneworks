{
  "name": "gcal-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal self-hosted MCP server exposing a create_event tool backed by the Google Calendar API. Consumed by the sneworks processAiTask Cloud Function via Anthropic's MCP connector.",
  "engines": { "node": "20" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "get-refresh-token": "node scripts/get-refresh-token.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.2",
    "googleapis": "^140.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
